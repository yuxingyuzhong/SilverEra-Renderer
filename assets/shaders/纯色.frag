#version 450
/*
纯色片元着色器（第二条着色器对的片元阶段）
用于「多材质 / 多管线」验收：不采样任何纹理，直接输出固定颜色，
从而与默认场景片元着色器（采样描述符集 1 的纹理）在同帧绘制中产生**可区分的像素结果**。
本着色器与「场景.vert」配对使用：顶点阶段仍走实例模型矩阵与场景 UBO，
管线布局与描述符集布局与默认场景管线完全一致（见 执行计划 · A.2 不变量 1）。
固定色取纯红：在 UNORM 与 sRGB 附件下取值一致（0 与 1 两种编码端点相同），便于格式无关断言。
*/

//颜色附件输出
layout(location = 0) out vec4 out_color;

void main()
{
	//纯红固定色（R = 1.0 线性，G / B = 0.0）
	out_color = vec4(1.0, 0.0, 0.0, 1.0);
}
