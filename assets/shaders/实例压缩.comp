#version 450
// GPU 实例压缩（第二百四十九轮）
// 与 CPU 端 frustum_cull_aabb 逐式同构：mvp = view_proj × model，8 角点变换到裁剪空间，
// 只要某一裁剪面「全部角点在外」即视为不可见；可见者用原子计数取槽位并写出压缩后的模型矩阵，
// 从而保证 GPU 压缩结果与 CPU 剔除结果在顺序与内容上一致（开/关两路径画面逐字节不变）。
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Transform_Block { vec4 transforms[]; } transform_block;
layout(set = 0, binding = 1) buffer Compact_Block { vec4 compacted[]; } compact_block;
layout(set = 0, binding = 2) buffer Counter_Block { uint visible_count; } counter_block;
// 距离 / 背面剔除参数（第二百五十轮；limits.x = 距离上限（≤0 不限）、limits.y = 背面开关）
// Hi-Z 遮挡参数（第二百五十六轮）：hi_z = (第 0 级宽, 第 0 级高, 级数, 是否启用)
layout(set = 0, binding = 3) buffer Params_Block
{
	vec4 camera_position;
	vec4 camera_forward;
	vec4 limits;
	vec4 hi_z;
} params_block;
// Hi-Z 金字塔（第二百五十六轮）：完整 mip 链，按级 texelFetch 读取
layout(set = 0, binding = 4) uniform sampler2D hi_z_source;

layout(push_constant) uniform Push_Compact
{
	// 视图 × 投影（列主序，4 列）
	layout(offset = 0) vec4 view_proj[4];
	// 网格局部 AABB
	layout(offset = 64) vec4 bounds_min;
	layout(offset = 80) vec4 bounds_max;
	// 实例数
	layout(offset = 96) uint count;
} push_compact;

void main()
{
	uint index = gl_GlobalInvocationID.x;
	if (index >= push_compact.count)
		return;
	mat4 view_proj = mat4(push_compact.view_proj[0], push_compact.view_proj[1],
		push_compact.view_proj[2], push_compact.view_proj[3]);
	uint base = index * 4u;
	mat4 model = mat4(transform_block.transforms[base + 0], transform_block.transforms[base + 1],
		transform_block.transforms[base + 2], transform_block.transforms[base + 3]);
	mat4 mvp = view_proj * model;
	// 实例世界中心（局部 AABB 中心经模型矩阵）
	vec3 center = (model * vec4((push_compact.bounds_min.xyz + push_compact.bounds_max.xyz) * 0.5, 1.0)).xyz;
	// 距离剔除（严格大于阈值才剔除；与 CPU distance_cull 同口径）
	float max_distance = params_block.limits.x;
	if (max_distance > 0.0 && distance(center, params_block.camera_position.xyz) > max_distance)
		return;
	// 背面剔除（点积严格小于 0 才剔除；与 CPU backface_cull 同口径）
	if (params_block.limits.y > 0.5 && dot(params_block.camera_forward.xyz, center - params_block.camera_position.xyz) < 0.0)
		return;
	// 六面「全部角点在外」标志（与 CPU 顺序一致：左 / 右 / 下 / 上 / 近 / 远）
	bool outside[6] = bool[6](true, true, true, true, true, true);
	for (int corner = 0; corner < 8; ++corner)
	{
		float x = ((corner & 1) != 0 ? push_compact.bounds_max.x : push_compact.bounds_min.x);
		float y = ((corner & 2) != 0 ? push_compact.bounds_max.y : push_compact.bounds_min.y);
		float z = ((corner & 4) != 0 ? push_compact.bounds_max.z : push_compact.bounds_min.z);
		vec4 clip = mvp * vec4(x, y, z, 1.0);
		if (!(clip.x > clip.w))
			outside[0] = false;
		if (!(clip.x < -clip.w))
			outside[1] = false;
		if (!(clip.y > clip.w))
			outside[2] = false;
		if (!(clip.y < -clip.w))
			outside[3] = false;
		if (!(clip.z < 0.0))
			outside[4] = false;
		if (!(clip.z > clip.w))
			outside[5] = false;
	}
	// 任一面全部在外即剔除（顺序不受影响，压缩保持原相对顺序）
	for (int plane = 0; plane < 6; ++plane)
		if (outside[plane])
			return;
	/*
	Hi-Z 遮挡（第二百五十六轮；仅在启用且上一帧金字塔有效时生效）
	与 CPU 参考 `hiz_occlusion_test` 同口径：投影 8 角点 → 屏幕矩形 + 最近深度；
	按矩形尺寸选级，覆盖纹素取最大远面深度；最近深度 > 最大值 + 0.002 才剔除。
	跨近平面 / 视图外一律判可见（保守）。
	*/
	if (params_block.hi_z.w > 0.5)
	{
		vec2 screen_min = vec2(3.0e38);
		vec2 screen_max = vec2(-3.0e38);
		float nearest = 1.0;
		bool cross_near = false;
		for (int corner = 0; corner < 8; ++corner)
		{
			float x = ((corner & 1) != 0 ? push_compact.bounds_max.x : push_compact.bounds_min.x);
			float y = ((corner & 2) != 0 ? push_compact.bounds_max.y : push_compact.bounds_min.y);
			float z = ((corner & 4) != 0 ? push_compact.bounds_max.z : push_compact.bounds_min.z);
			vec4 clip = mvp * vec4(x, y, z, 1.0);
			// 跨近平面 / 相机后方：保守判可见
			if (clip.w <= 0.0)
			{
				cross_near = true;
				continue;
			}
			vec3 ndc = clip.xyz / clip.w;
			vec2 screen = vec2((ndc.x * 0.5 + 0.5) * params_block.hi_z.x,
				(0.5 - ndc.y * 0.5) * params_block.hi_z.y);
			screen_min = min(screen_min, screen);
			screen_max = max(screen_max, screen);
			nearest = min(nearest, ndc.z);
		}
		// 跨近平面 / 视图外不在此剔除
		bool in_view = !cross_near
			&& !(screen_max.x < 0.0 || screen_max.y < 0.0
				|| screen_min.x >= params_block.hi_z.x || screen_min.y >= params_block.hi_z.y);
		if (in_view)
		{
			// 保守外扩 1 像素（抵消投影包围盒与光栅化差异；第二百五十七轮）
			const float DILATE = 1.0;
			vec2 dilated_min = screen_min - vec2(DILATE);
			vec2 dilated_max = screen_max + vec2(DILATE);
			// 选级：覆盖纹素不超过 2×2；末两级不采样（保守口径，见 CPU 参考）
			float extent = max(max(dilated_max.x - dilated_min.x, dilated_max.y - dilated_min.y), 1.0);
			int levels = int(params_block.hi_z.z);
			int level_cap = levels >= 2 ? levels - 2 : 0;
			int level = int(ceil(log2(extent)));
			level = clamp(level, 0, level_cap);
			// 该级尺寸
			int level_width = max(1, int(params_block.hi_z.x) >> level);
			int level_height = max(1, int(params_block.hi_z.y) >> level);
			int scale = 1 << level;
			// 矩形映射到该级纹素范围并钳制
			int min_x = clamp(int(floor(dilated_min.x / float(scale))), 0, level_width - 1);
			int max_x = clamp(int(floor(dilated_max.x / float(scale))), 0, level_width - 1);
			int min_y = clamp(int(floor(dilated_min.y / float(scale))), 0, level_height - 1);
			int max_y = clamp(int(floor(dilated_max.y / float(scale))), 0, level_height - 1);
			// 覆盖纹素的最大远面深度（保守）
			float farthest = 0.0;
			for (int ty = min_y; ty <= max_y; ++ty)
				for (int tx = min_x; tx <= max_x; ++tx)
					farthest = max(farthest, texelFetch(hi_z_source, ivec2(tx, ty), level).r);
			// 最近深度严格大于远面深度 + 容差才完全遮挡
			if (nearest > farthest + 0.002)
				return;
		}
	}
	uint slot = atomicAdd(counter_block.visible_count, 1u);
	uint out_base = slot * 4u;
	compact_block.compacted[out_base + 0] = transform_block.transforms[base + 0];
	compact_block.compacted[out_base + 1] = transform_block.transforms[base + 1];
	compact_block.compacted[out_base + 2] = transform_block.transforms[base + 2];
	compact_block.compacted[out_base + 3] = transform_block.transforms[base + 3];
}
